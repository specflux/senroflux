parameters:
    level: 8
    paths:
        - src
        - senroflux.php
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanFiles:
        # WordPress core symbols referenced from src (declarations only).
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    # Justified, scoped suppressions for known wordpress-stubs false positives
    # (stub-signature limitations, not defects). Each entry is pinned to an
    # exact message so a NEW violation fails loudly instead of being absorbed.
    ignoreErrors:
        -
            # wpdb::prepare()'s stub requires `@phpstan-param literal-string
            # $query`, but every prepared statement interpolates this plugin's
            # OWN computed table names into an otherwise-literal SQL template
            # — never request/user input.
            message: '#^Parameter \#1 \$query of method wpdb::prepare\(\) expects literal\-string, non\-falsy\-string given\.$#'
            path: src/*
            count: 5
        -
            # Same family: prepare() returns string|void per the stub, which
            # collides with query()'s non-nullable string parameter.
            message: '#^Parameter \#1 \$query of method wpdb::query\(\) expects string, string\|null given\.$#'
            path: src/*
            count: 1
        -
            # Message::fromArray() documents a narrow PHPStan array-shape
            # generic; Step stores exactly toArray() output (S4), so the shape
            # holds BY CONSTRUCTION and the SDK's generic cannot see it.
            message: '#^Parameter \#1 \$array of static method WordPress\\AiClient\\Messages\\DTO\\Message::fromArray\(\) expects array\{role: string, parts: array.*given\.$#'
            path: src/Run/Step.php
            count: 1
        -
            # Defensive runtime checks against wp_get_ability()'s real-world
            # null/object outcomes. wordpress-stubs types the return as
            # non-nullable WP_Ability, so these two checks look constant to
            # PHPStan — they are not, across real WordPress versions and the
            # test shim.
            message: '#^Call to function is_object\(\) with WP_Ability will always evaluate to true\.$#'
            path: src/Tools/ToolExecutor.php
            count: 1
        -
            # Schema::ensureUpgrade()'s require_once is a real-WordPress-only
            # fallback (dbDelta() always exists mid-request in core) for a
            # genuine WP-core file that never exists in this checkout.
            message: '#^Path in require_once\(\) ".*wp\-admin/includes/upgrade\.php" is not a file or it does not exist\.$#'
            path: src/Schema.php
            count: 1
        -
            # Message::fromArray() documents a narrow PHPStan array-shape
            # generic; Runner stores exactly toArray() output (S4), so the
            # shape holds BY CONSTRUCTION (same as Step::toMessage()).
            # Two call sites: unconsumedCalls() and latestAskUserCallId().
            message: '#^Parameter \#1 \$array of static method WordPress\\AiClient\\Messages\\DTO\\Message::fromArray\(\) expects array\{role: string, parts: array.*given\.$#'
            path: src/Run/*
            count: 3
        -
            # The Agent Safety go-forward pack lives in the external
            # wp-agentsafety plugin, which is NOT installed in this checkout;
            # phpstan therefore cannot resolve these classes. Every code path
            # that touches them is already behind a `class_exists()` guard
            # (agentSafetyBindingError() / agentSafetyPack()).
            message: '#^Method Specflux\\SenroFlux\\Packs\\Pages\\PagesPack::resolveAsPackForUser\(\) has invalid return type Specflux\\AgentSafety\\Packs\\Pack\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 2
        -
            # Same external-class situation: PackResolver is only reached after
            # the class_exists() guard in agentSafetyBindingError().
            message: '#^Instantiated class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver not found\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 1
        -
            # registry() is a method on the external PackResolver, reached only
            # behind the same class_exists() guard.
            message: '#^Call to method registry\(\) on an unknown class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 1
