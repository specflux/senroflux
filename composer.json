{
    "name": "specflux/senroflux",
    "description": "Resumable multi-step agent runs inside the logged-in WordPress session, governed by Agent Safety.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/wordpress-stubs": "^7.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "wordpress/php-ai-client": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Specflux\\SenroFlux\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
