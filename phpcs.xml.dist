<?xml version="1.0"?>
<ruleset name="SenroFlux">
    <description>WordPress-Core + WordPress-Extra for the SenroFlux plugin.</description>

    <file>senroflux.php</file>
    <file>src</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="ps"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>

    <!--
        Prefix every global the plugin introduces (hooks, options, tables,
        ajax actions, functions) with senroflux_. Namespaces keep the
        Specflux\ vendor prefix per the project layout decision.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="senroflux"/>
                <element value="Specflux"/>
            </property>
        </properties>
    </rule>

    <!--
        src/ uses PSR-4 class-file names (Plugin.php), by spec: the runtime
        autoloader is Composer, not WP's class-plugin.php convention.
        WordPress.Files.FileName would force snake_case files and break it.
    -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        The spec fixes BOTH this ruleset (WPCS) AND a PSR-4 camelCase
        namespace (Specflux\SenroFlux\) that integrates the AI Client SDK.
        Case-enforcement sniffs cannot coexist with that decision, so they
        yield for namespaced OO code only — every other rule (escaping, SQL
        preparation, prefixes, yoda, formatting) stays fully enforced, and
        senroflux.php keeps the complete standard.
    -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        src/api.php exists to declare the global senroflux() locator: side
        effects are its contract, same as the plugin main file. Every other
        src file guards itself with `defined( 'ABSPATH' ) || exit;`, which the
        SideEffects sniff counts as a side effect — that guard is required
        WordPress hardening, so the sniff yields to it.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>src/api.php</exclude-pattern>
        <exclude-pattern>senroflux.php</exclude-pattern>
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>

    <!--
        tests/bootstrap.php defines WordPress function SHIMS under their REAL
        upstream names (add_action, esc_html__, ...) — prefixing them would
        defeat the point. tests/stubs/wpdb.php likewise declares the REAL
        global wpdb class + ARRAY_A constant so the store exercises the true
        contract shapes. Both relaxed for those files only.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PEAR.NamingConventions.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <!--
        The wp_die() SHIM throws (tests observe deaths); the escaping sniff
        pattern-matches the wp_die name and demands escaped output.
    -->
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <!-- The bare-PHPUnit STDERR hint cannot go through WP_Filesystem. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <!-- The test harness installs the emulated wpdb as the global. -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- Stub files legitimately mix the fake class with its global shims. -->
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>

    <config name="testVersion" value="8.1-"/>
</ruleset>
